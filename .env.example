# Copy to .env and fill in values. Never commit .env.
#
# GitHub Actions (auto-login): create repository secrets matching these names:
#   BASE_URL, AUTH_API_BASE_URL (or LOGIN_URL), VALID_EMAIL, VALID_PASSWORD
#   Optional: SERVICE_ID, PROVIDER_ID
# Do not set ACCESS_TOKEN in CI if you want a fresh token from Login API each run.

BASE_URL=https://dev-console-api.jpmob.jp/api/v1
# Full login endpoint URL (optional). CI: set LOGIN_URL secret, or use AUTH_API_BASE_URL + /login.
# LOGIN_URL=https://dxhub-dev-api.innovaturelabs.net/api/v1/login
AUTH_API_BASE_URL=https://dxhub-dev-api.innovaturelabs.net/api/v1
PROVIDER_ID=1
SERVICE_ID=1

# If the auth host in AUTH_API_BASE_URL does not match the TLS certificate (e.g. cert is *.jpmob.jp),
# fix AUTH_API_BASE_URL to the correct hostname first. Only for local debugging:
# DXHUB_LOGIN_INSECURE_TLS=1

VALID_EMAIL=super-admin@example.com
VALID_PASSWORD=Admin@123
INVALID_PASSWORD=Invalid@123
INVALID_EMAIL=no-user-login-test@invalid.example.com

# Allure: set to false to generate the HTML report without opening the browser after tests
# ALLURE_OPEN=false
